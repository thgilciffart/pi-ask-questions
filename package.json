{
	"name": "pi-ask-questions",
	"version": "0.4.0",
	"description": "Interactive questionnaires for Pi: tabs, multi-select, free-form typing, validation, and structured answers.",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"questions",
		"questionnaire",
		"ask",
		"multi-select",
		"tui"
	],
	"license": "MIT",
	"author": "thgilciffart <73938431+thgilciffart@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thgilciffart/pi-ask-questions.git"
	},
	"homepage": "https://github.com/thgilciffart/pi-ask-questions#readme",
	"bugs": {
		"url": "https://github.com/thgilciffart/pi-ask-questions/issues"
	},
	"type": "module",
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"scripts": {
		"test": "node --test \"test/**/*.test.ts\"",
